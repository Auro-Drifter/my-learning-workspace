{
  "name": "my-learning-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch server/main.ts --dev",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:pages": "npm run typecheck && vite build --mode pages",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "npm run build && node tests/workspace.e2e.ts",
    "prestart": "npm run build",
    "start": "node server/main.ts",
    "serve": "node server/main.ts"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fastify/static": "10.1.11",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "codemirror": "6.0.2",
    "fastify": "5.12.8",
    "katex": "0.19.1",
    "lucide-react": "1.73.0",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-grid-layout": "2.3.0",
    "react-markdown": "10.1.0",
    "react-resizable": "3.1.3",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "zod": "4.6.7"
  },
  "overrides": {
    "katex": "$katex"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.65.1",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
